# Server
PORT=3000
NODE_ENV=production

# Logging — set to "debug" for verbose output, "silent" to suppress all logs
LOG_LEVEL=info

# Health check concurrency & timeouts
# Raise HEALTH_MAX_CONCURRENT with caution — each slot opens a Playwright page
HEALTH_MAX_CONCURRENT=20
HEALTH_GLOBAL_TIMEOUT=120000
HEALTH_SLOT_TIMEOUT=90000
HEALTH_NAV_TIMEOUT=15000

# Per-check behaviour
HEALTH_MAX_PAGES=3
HEALTH_MAX_PHONE_TESTS=50
HEALTH_MAX_EMAIL_TESTS=50
HEALTH_POLL_MS=3000
HEALTH_SECOND_POLL_MS=1500
HEALTH_SETTLE_MS=600
HEALTH_FORM_WAIT_MS=5000
HEALTH_CONSENT_WAIT=4000

# Test identity values injected into forms during health checks
HEALTH_TEST_EMAIL=test-automation@example.com
HEALTH_TEST_PHONE=01632960123
HEALTH_TEST_MESSAGE=This is a tracking health check. Please ignore.

# ─────────────────────────────────────────────────────────────────────────────
# Orchestrator (src/orchestrator, src/playwright, src/api)
# ─────────────────────────────────────────────────────────────────────────────

# Supabase — used by src/lib/supabase.js
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Monday.com — API key and board IDs
MONDAY_API_KEY=
MONDAY_BOARD_ID_LSEO=1242223716
MONDAY_BOARD_ID_TRIALS=5088296844
MONDAY_GROUP_ID=1690115520_call360_telephony_s

# Monday.com — item column IDs (same on both boards unless noted)
MONDAY_COL_ORDER_NUMBER=text50
MONDAY_COL_CID=cid
MONDAY_COL_WEBSITE_URL=short_text7
MONDAY_COL_CMS_CREDS=long_text4
MONDAY_COL_NOTES=text_mm1myf7x
MONDAY_COL_STATUS=status70

# Monday.com — "info needed" reason column (differs per board)
MONDAY_COL_INFO_REASON_LSEO=color_mm1gsawq
MONDAY_COL_INFO_REASON_TRIALS=color_mm1g7w89

# Google OAuth2 — shared OAuth client app (used to refresh per-account tokens)
# Client ID and Secret come from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Ads — shared credential across all 12 Leadgen accounts
# Refresh token extracted from n8n: n8n export:credentials --decrypted | grep refresh_token
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=4DkVyyBUvjMbEDOgbE9QBQ
GOOGLE_ADS_LOGIN_CUSTOMER_ID=7651196543
